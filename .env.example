AI_SERVICE_PORT=8000
BACKEND_URL=http://localhost:5000

# Shared secret the backend must send in the X-Internal-Secret header.
# Set the same value as AI_SERVICE_SECRET in the backend env.
AI_SERVICE_SECRET=change_me_to_a_long_random_string

# Hosts the service may download media from when given a fileUrl (comma-separated).
ALLOWED_FILE_HOSTS=res.cloudinary.com

# Optional: Gemini for coaching text, chatbot and growth feedback
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Optional: custom model weights
YOLO_WEIGHTS_PATH=yolov8n.pt
LSTM_WEIGHTS_PATH=weights/batting_lstm.pt
YOLO_POSE_WEIGHTS_PATH=yolov8n-pose.pt

# Analysis engine tuning (defaults shown)
# ANALYSIS_CONCURRENCY=1          # analyses run at once (MediaPipe is serialised anyway)
# ANALYSIS_WINDOW_SECONDS=3.5     # length of the window analysed around the shot/delivery
# ANALYSIS_TIME_BUDGET_SECS=400   # abort an analysis that runs longer than this
# MAX_UPLOAD_MB=500
